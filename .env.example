# ==============================================================================
# Growth System Agent — Production Environment Configuration
# Owner: Zia Ul Din (ziauldin371@gmail.com)
# Role: Full Stack AI Developer & Automation Architect | LLMs & Python | Data Science
# ==============================================================================

# Application Base URL (Vercel deployment URL or localhost)
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Authorized Administrator Credentials & Cryptographic Session Hardening
ADMIN_EMAIL=ziauldin371@gmail.com
ADMIN_PASSWORD=your_secure_password_here
SESSION_SECRET=generate_a_secure_random_session_secret_32_chars_here

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth
# Required for multi-tenant persistence, Row Level Security, and lead dossiers.
# In local/sandbox development, runs automatically with In-Memory fallback.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Email Delivery — Gmail API with Google OAuth2
# Configured sender: ziauldin371@gmail.com
# ------------------------------------------------------------------------------
EMAIL_FROM_ADDRESS=ziauldin371@gmail.com
EMAIL_FROM_NAME="Zia Ul Din | AI & Automation Solutions"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Alternative Email Delivery Provider (Fallback if Gmail API is unconfigured)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=mock # Options: gmail | resend | mock

# ------------------------------------------------------------------------------
# AI LLM Provider Configuration
# Supported providers: gemini | openai | mock
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Business Discovery Providers
# Supported: google_places | companies_house | auto | b2b_mock
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
COMPANIES_HOUSE_API_KEY=
PLACES_MONTHLY_BUDGET=200

# ------------------------------------------------------------------------------
# Scheduler & Automation Execution (09:00 & 17:00 PKT / 04:00 & 12:00 UTC)
# Authenticates Vercel Cron and GitHub Actions workflow
# ------------------------------------------------------------------------------
CRON_SECRET=generate_a_secure_random_cron_secret_here

# ------------------------------------------------------------------------------
# Operating Modes & Safety Guardrails
# ------------------------------------------------------------------------------
# Operating Mode: research (discover only) | approval (generate drafts) | auto_send (controlled send)
DEFAULT_SEND_MODE=approval
AUTO_SEND_ENABLED=false
EMERGENCY_STOP=false
DAILY_EMAIL_LIMIT=50
SENDING_WINDOW_START_HOUR=9
SENDING_WINDOW_END_HOUR=17
RATE_LIMIT_DELAY_SECONDS=60

# Statutory CAN-SPAM Physical Address (Required on all outgoing emails)
PHYSICAL_MAILING_ADDRESS="123 Innovation Way, Suite 400, San Francisco, CA 94105"
