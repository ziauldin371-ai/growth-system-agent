# ==============================================================================
# GrowthSignal AI — Environment Configuration Template
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required for database persistence, auth, and Row Level Security.
# When unconfigured, the application runs with an in-memory/sqlite mock repository.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Background Queue Configuration
# Redis is optional. If REDIS_URL is not provided, the platform uses its built-in
# durable transactional database/in-memory queue engine.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AI LLM Provider Configuration
# Supported providers: gemini | openai | anthropic | mock
# Defaults to mock provider if no API keys are supplied.
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Business Discovery Providers
# Supported providers: google_places | companies_house | b2b_mock
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
COMPANIES_HOUSE_API_KEY=
APOLLO_API_KEY=
CRUSTDATA_API_KEY=

# ------------------------------------------------------------------------------
# Email Delivery & Sender Setup
# Providers: mock | resend | sendgrid
# Default mode is STRICTLY draft_only until explicitly approved by an admin.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=mock
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=outreach@yourdomain.com
EMAIL_FROM_NAME="GrowthSignal AI"
# Required by CAN-SPAM and global compliance:
PHYSICAL_MAILING_ADDRESS="123 Innovation Way, Suite 400, San Francisco, CA 94105"

# ------------------------------------------------------------------------------
# Compliance, Safety Controls & Guardrails
# ------------------------------------------------------------------------------
DEFAULT_SEND_MODE=draft_only
EMERGENCY_STOP=false
MAX_DAILY_EMAILS=50
SENDING_WINDOW_START_HOUR=9
SENDING_WINDOW_END_HOUR=17
RATE_LIMIT_DELAY_SECONDS=60
